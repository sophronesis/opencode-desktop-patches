+  "Calling my lawyer",
+  "Summoning a sev1",
+  "Outsourcing to an intern",
+  "Escalating to the CIA",
+  "Buying GPUs from a guy",
+  "Draining the aquifer",
+  "Committing securities fraud",
+  "Doing a light war crime",
+  "Rugpulling",
+  "Front-running your commit",
+  "we have code at home. the code at home:",
+  "every day we stray further from god",
+  "the function name is a lie. the comments are a lie. everything is a lie",
+  "look at me. i am the maintainer now",
+  "in this economy? you want me to write tests in this economy?",
+  "we do a little refactoring",
+  "hear me out. what if we just...",
+  "anyway, so i started blasting",
+]
+
+const ROTATE_MS = 8_000
+
+const [tick, setTick] = createSignal(0)
+setInterval(() => setTick((v) => v + 1), ROTATE_MS)
+
+/**
+ * Creates an independent verb accessor. Every call site gets its own random
+ * salt, so the timeline and each inbox row show different verbs, while all of
+ * them rotate together every ROTATE_MS and stay stable within a window. Call
+ * the accessor during render - it reads the tick signal, so Solid re-evaluates
+ * it when the window rolls over. Do NOT call Math.random() inside the
+ * accessor: the inbox row re-evaluates every second for the elapsed duration
+ * and the verb would flicker per second. `max` truncates long verbs for
+ * narrow slots, keeping an ellipsis.
+ */
+export function createSpinnerVerb(): (max?: number) => string {
+  const salt = Math.floor(Math.random() * VERBS.length)
+
+  return (max?: number) => {
+    const index = ((tick() + salt) * 2654435761) % VERBS.length
+    const verb = VERBS[index]!
+    if (max !== undefined && verb.length > max) {
+      return `${verb.slice(0, Math.max(1, max - 1))}…`
+    }
+    return verb
+  }
+}
